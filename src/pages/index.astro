---
import '@fontsource-variable/archivo/wdth.css';
import { site } from '../config';
import { districts, suburbs, allSuburbs } from '../areas';

const title = `Ślusarz 24h Warszawa – awaryjne otwieranie drzwi i aut | ${site.name}`;
const description = `Pogotowie zamkowe całą dobę: otwieranie mieszkań, samochodów i sejfów, klucze samochodowe, immobilizery, zamki Gerda. Każda dzielnica Warszawy i okolice. Tel. ${site.phoneDisplay}.`;

const services = [
  { name: 'Otwieranie drzwi mieszkań', text: 'Zatrzaśnięte, zgubione klucze, zacięty zamek. Otwieramy drzwi do mieszkań i domów o każdej porze.' },
  { name: 'Otwieranie samochodów', text: 'Kluczyk w stacyjce, w bagażniku albo zgubiony. Otwieramy auto na miejscu, tam gdzie stoi.' },
  { name: 'Otwieranie sejfów', text: 'Zapomniany szyfr, rozładowany zamek elektroniczny, uszkodzony mechanizm. Dostęp do zawartości bez wywożenia sejfu.' },
  { name: 'Naprawa stacyjek i immobilizerów', text: 'Stacyjka nie przekręca się, auto nie widzi kluczyka. Diagnozujemy i naprawiamy na miejscu.' },
  { name: 'Dorabianie kluczy samochodowych', text: 'Zapasowy kluczyk albo nowy w miejsce zgubionego, razem z zaprogramowaniem do auta.' },
  { name: 'Serwis zamków Gerda', text: 'Naprawa, regulacja i wymiana wkładek oraz zamków Gerda w drzwiach antywłamaniowych.' },
  { name: 'Montaż i wymiana zamków', text: 'Po włamaniu, przeprowadzce albo zgubieniu kluczy. Dobieramy zamek do drzwi i montujemy od razu.' },
];

const steps = [
  { name: 'Dzwonisz', text: 'Mówisz, gdzie jesteś i co się stało. Od razu podajemy cenę i przybliżony czas dojazdu.' },
  { name: 'Jedziemy', text: 'Ślusarz rusza do Ciebie z narzędziami do tego konkretnego zamka.' },
  { name: 'Otwieramy', text: 'Najpierw próbujemy metod bez uszkodzeń. O każdej zmianie planu mówimy przed rozpoczęciem pracy.' },
  { name: 'Płacisz', text: 'Dopiero po wykonanej usłudze, według ceny ustalonej przez telefon.' },
];

const faq = [
  { q: 'Ile kosztuje otwarcie drzwi?', a: 'Zależy od zamka, pory i miejsca. Cenę podajemy przez telefon, zanim ślusarz wyjedzie, i tej ceny się trzymamy.' },
  { q: 'Czy przyjedziecie w nocy albo w święta?', a: 'Tak. Pracujemy całą dobę, także w weekendy i święta.' },
  { q: 'Czy drzwi zostaną uszkodzone?', a: 'Zaczynamy od metod, które nie niszczą zamka ani drzwi. Jeśli zamek trzeba rozwiercić, mówimy o tym wcześniej i od razu montujemy nowy.' },
  { q: 'Czego potrzebujecie ode mnie przy otwieraniu mieszkania?', a: 'Dokumentu, który potwierdza, że możesz wejść do lokalu, np. dowodu z adresem albo umowy najmu. Chronimy w ten sposób także Ciebie.' },
  { q: 'Czy dojeżdżacie poza Warszawę?', a: `Tak. Obsługujemy każdą dzielnicę Warszawy oraz miejscowości wokół miasta, m.in. ${allSuburbs.slice(0, 6).join(', ')} i inne.` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Locksmith',
  name: site.name,
  telephone: site.phoneHref,
  url: site.url,
  openingHours: 'Mo-Su 00:00-23:59',
  areaServed: [{ '@type': 'City', name: 'Warszawa' }, ...allSuburbs.map((n) => ({ '@type': 'City', name: n }))],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Usługi ślusarskie', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } })) },
};
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site.url + '/'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#FFD21F" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#tresc">Przejdź do treści</a>

  <header class="bar">
    <a class="brand" href="/">Otwieramy<span>24</span></a>
    <a class="bar-call" href={`tel:${site.phoneHref}`}>Zadzwoń: {site.phoneDisplay}</a>
  </header>

  <main id="tresc">
    <section class="hero">
      <p class="now" data-now><span class="dot" aria-hidden="true"></span><span data-now-text>Pracujemy całą dobę. Odbieramy.</span></p>
      <h1>Zamknięte drzwi, auto albo sejf? Dzwoń, przyjedziemy.</h1>
      <a class="number" href={`tel:${site.phoneHref}`} aria-label={`Zadzwoń pod numer ${site.phoneDisplay}`}>{site.phoneDisplay}</a>
      <p class="lede">Pogotowie zamkowe w Warszawie i okolicach. Każda dzielnica, przedmieścia, dzień i noc, weekendy i święta.</p>
    </section>

    <div class="tape" aria-hidden="true"></div>

    <section class="services" aria-labelledby="uslugi">
      <h2 id="uslugi">Z czym przyjeżdżamy</h2>
      <ul>
        {services.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="steps" aria-labelledby="jak">
      <h2 id="jak">Od telefonu do otwartych drzwi</h2>
      <ol>
        {steps.map((s, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="area" aria-labelledby="obszar">
      <div class="area-inner">
        <h2 id="obszar">Dojeżdżamy do każdej dzielnicy Warszawy i na przedmieścia</h2>
        <p class="area-lede">Nie ma znaczenia, czy stoisz pod blokiem na Bródnie, czy pod domem w Konstancinie. Obsługujemy całe miasto i okolice.</p>

        <h3>Wszystkie 18 dzielnic Warszawy</h3>
        <ul class="districts">
          {districts.map((d) => <li>{d}</li>)}
        </ul>

        <h3>Okolice i przedmieścia</h3>
        <div class="suburbs">
          {Object.entries(suburbs).map(([dir, list]) => (
            <div>
              <h4>{dir}</h4>
              <p>{list.join(', ')}</p>
            </div>
          ))}
        </div>
        <p class="area-note">Nie widzisz swojej miejscowości? Zadzwoń. Jeśli leży w okolicy Warszawy, najpewniej dojedziemy.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="pytania">
      <h2 id="pytania">Zanim zadzwonisz</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="final">
      <h2>Stoisz pod drzwiami?</h2>
      <a class="number number-sm" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
    </section>
  </main>

  <footer class="foot">
    <p><strong>{site.name}</strong>. Pogotowie zamkowe 24h, Warszawa i okolice.</p>
    <p><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></p>
  </footer>

  <a class="dock" href={`tel:${site.phoneHref}`}>Zadzwoń teraz: {site.phoneDisplay}</a>

  <script>
    const el = document.querySelector('[data-now-text]');
    if (el) {
      const d = new Date();
      const h = d.getHours();
      const time = d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
      const part = h < 5 ? 'w nocy' : h < 12 ? 'rano' : h < 18 ? 'po południu' : h < 22 ? 'wieczorem' : 'w nocy';
      el.textContent = `Jest ${time} ${part}. Odbieramy.`;
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --yellow: #FFD21F;
    --ink: #000;
    --paper: #fff;
    --concrete: #E4E2DC;
    --signal: #D7261E;
    --wide: 'Archivo Variable', 'Arial Narrow', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--wide);
    font-size: 1.0625rem;
    line-height: 1.55;
    font-variation-settings: 'wdth' 100;
  }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--yellow); }
  h1, h2, h3, h4 { margin: 0; font-variation-settings: 'wdth' 62; line-height: 1; }
  p { margin: 0; }

  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--yellow); padding: .75rem 1rem; z-index: 10; }
  .skip:focus { left: 1rem; }

  /* Pasek górny */
  .bar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: .875rem clamp(1rem, 4vw, 3rem);
    background: var(--yellow);
    border-bottom: 3px solid var(--ink);
  }
  .brand { font-weight: 900; font-size: 1.5rem; text-decoration: none; font-variation-settings: 'wdth' 62; letter-spacing: -.01em; }
  .brand span { background: var(--ink); color: var(--yellow); padding: 0 .2em; margin-left: .1em; }
  .bar-call { font-weight: 700; text-decoration: none; border: 3px solid var(--ink); padding: .4rem .9rem; }
  .bar-call:hover { background: var(--ink); color: var(--yellow); }

  /* Hero: numer telefonu to bohater */
  .hero {
    background: var(--yellow);
    padding: clamp(2.5rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem) clamp(2.5rem, 6vw, 5rem);
  }
  .now { display: inline-flex; align-items: center; gap: .6rem; font-weight: 600; font-size: 1rem; margin-bottom: 1.5rem; }
  .dot { width: .7rem; height: .7rem; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 0 rgba(215, 38, 30, .6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 .6rem rgba(215, 38, 30, 0); } 100% { box-shadow: 0 0 0 0 rgba(215, 38, 30, 0); } }
  .hero h1 { font-size: clamp(1.75rem, 4.2vw, 3.25rem); font-weight: 800; max-width: 22ch; }
  .number {
    display: block;
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(1.25rem, 3vw, 2rem) -.04em;
    font-size: clamp(4rem, 16.5vw, 15rem);
    font-weight: 900;
    font-variation-settings: 'wdth' 62;
    line-height: .85;
    letter-spacing: -.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .number:hover { text-decoration: underline; text-decoration-thickness: .06em; text-underline-offset: .08em; }
  .lede { font-size: clamp(1.0625rem, 1.6vw, 1.3rem); max-width: 46ch; }

  .tape {
    height: 1.75rem;
    background: repeating-linear-gradient(-45deg, var(--ink) 0 1.25rem, var(--yellow) 1.25rem 2.5rem);
    border-block: 3px solid var(--ink);
  }

  section h2 { font-size: clamp(2rem, 5vw, 3.75rem); font-weight: 900; letter-spacing: -.01em; }

  /* Usługi */
  .services, .steps, .faq, .final { padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem); }
  .services h2 { margin-bottom: 2rem; }
  .services ul { list-style: none; padding: 0; margin: 0; border-top: 4px solid var(--ink); }
  .services li {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: .5rem 2rem; align-items: baseline;
    padding: 1.25rem 0; border-bottom: 2px solid var(--ink);
  }
  .services h3 { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; }
  .services p { max-width: 52ch; }

  /* Kroki */
  .steps { background: var(--concrete); }
  .steps h2 { margin-bottom: 2.5rem; max-width: 16ch; }
  .steps ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .step-n {
    display: grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: 1rem;
    background: var(--yellow); border: 3px solid var(--ink);
    font-weight: 900; font-size: 1.5rem; font-variation-settings: 'wdth' 62;
  }
  .steps h3 { font-size: 1.75rem; font-weight: 800; margin-bottom: .5rem; }

  /* Obszar */
  .area { background: var(--ink); color: var(--paper); padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem); }
  .area h2 { color: var(--yellow); max-width: 20ch; }
  .area-lede { margin: 1.25rem 0 3rem; max-width: 52ch; font-size: 1.15rem; }
  .area h3 { font-size: 1.5rem; font-weight: 800; color: var(--yellow); margin: 0 0 1rem; }
  .districts { list-style: none; padding: 0; margin: 0 0 3rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .districts li {
    border: 2px solid var(--yellow); padding: .35rem .8rem;
    font-weight: 700; font-size: 1.125rem; font-variation-settings: 'wdth' 75;
  }
  .suburbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .suburbs h4 { font-size: 1.125rem; font-weight: 800; margin-bottom: .4rem; font-variation-settings: 'wdth' 75; }
  .suburbs p { color: #D9D9D9; }
  .area-note { margin-top: 2.5rem; font-weight: 600; }

  /* FAQ */
  .faq h2 { margin-bottom: 2rem; }
  .faq details { border-top: 2px solid var(--ink); max-width: 60rem; }
  .faq details:last-of-type { border-bottom: 2px solid var(--ink); }
  .faq summary {
    cursor: pointer; list-style: none; padding: 1.1rem 2.5rem 1.1rem 0; position: relative;
    font-weight: 700; font-size: 1.25rem;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: .25rem; top: .7rem; font-size: 1.75rem; font-weight: 400; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { padding: 0 0 1.25rem; max-width: 62ch; }

  .final { background: var(--yellow); border-top: 3px solid var(--ink); }
  .number-sm { font-size: clamp(3.25rem, 12vw, 9rem); margin-bottom: 0; }

  .foot { padding: 2rem clamp(1rem, 4vw, 3rem) 6rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 3px solid var(--ink); }

  /* Przycisk na dole ekranu (telefon) */
  .dock {
    position: fixed; left: .75rem; right: .75rem; bottom: .75rem; z-index: 5;
    display: none; text-align: center; padding: 1rem;
    background: var(--ink); color: var(--yellow); font-weight: 800; font-size: 1.125rem; text-decoration: none;
    border: 3px solid var(--yellow); outline: 3px solid var(--ink);
  }

  @media (max-width: 900px) {
    .steps ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .suburbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .bar-call { display: none; }
    .services li { grid-template-columns: 1fr; }
    .steps ol, .suburbs { grid-template-columns: 1fr; }
    .dock { display: block; }
    .foot { padding-bottom: 6rem; }
  }
  @media (min-width: 641px) { .foot { padding-bottom: 2rem; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
</style>
