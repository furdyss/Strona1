---
import '@fontsource-variable/archivo/wdth.css';
import { Image } from 'astro:assets';
import doorPhoto from '../assets/drzwi-klucz.jpg';
import carPhoto from '../assets/wytrych-auto.jpg';
import { site } from '../config';
import { districts, suburbs, allSuburbs } from '../areas';

const title = `Ślusarz 24h Warszawa – awaryjne otwieranie drzwi i aut | ${site.name}`;
const description = `Pogotowie zamkowe całą dobę: otwieranie mieszkań, samochodów i sejfów, klucze samochodowe, immobilizery, zamki Gerda. Każda dzielnica Warszawy i okolice. Tel. ${site.phoneDisplay}.`;

const services = [
  { name: 'Otwieranie drzwi mieszkań', text: 'Zatrzaśnięte, zgubione klucze, zacięty zamek. Otwieramy drzwi do mieszkań i domów o każdej porze.' },
  { name: 'Otwieranie samochodów', text: 'Kluczyk w stacyjce, w bagażniku albo zgubiony. Otwieramy auto na miejscu, tam gdzie stoi.' },
  { name: 'Otwieranie sejfów', text: 'Zapomniany szyfr, rozładowany zamek elektroniczny, uszkodzony mechanizm. Dostęp do zawartości bez wywożenia sejfu.' },
  { name: 'Naprawa stacyjek i immobilizerów', text: 'Stacyjka nie przekręca się, auto nie widzi kluczyka. Diagnozujemy i naprawiamy na miejscu.' },
  { name: 'Dorabianie kluczy samochodowych', text: 'Zapasowy kluczyk albo nowy w miejsce zgubionego, razem z zaprogramowaniem do auta.' },
  { name: 'Serwis zamków Gerda', text: 'Naprawa, regulacja i wymiana wkładek oraz zamków Gerda w drzwiach antywłamaniowych.' },
  { name: 'Montaż i wymiana zamków', text: 'Po włamaniu, przeprowadzce albo zgubieniu kluczy. Dobieramy zamek do drzwi i montujemy od razu.' },
];

const steps = [
  { name: 'Dzwonisz', text: 'Mówisz, gdzie jesteś i co się stało. Od razu podajemy cenę i przybliżony czas dojazdu.' },
  { name: 'Jedziemy', text: 'Ślusarz rusza do Ciebie z narzędziami do tego konkretnego zamka.' },
  { name: 'Otwieramy', text: 'Najpierw próbujemy metod bez uszkodzeń. O każdej zmianie planu mówimy przed rozpoczęciem pracy.' },
  { name: 'Płacisz', text: 'Dopiero po wykonanej usłudze, według ceny ustalonej przez telefon.' },
];

const faq = [
  { q: 'Ile kosztuje otwarcie drzwi?', a: 'Zależy od zamka, pory i miejsca. Cenę podajemy przez telefon, zanim ślusarz wyjedzie, i tej ceny się trzymamy.' },
  { q: 'Czy przyjedziecie w nocy albo w święta?', a: 'Tak. Pracujemy całą dobę, także w weekendy i święta.' },
  { q: 'Czy drzwi zostaną uszkodzone?', a: 'Zaczynamy od metod, które nie niszczą zamka ani drzwi. Jeśli zamek trzeba rozwiercić, mówimy o tym wcześniej i od razu montujemy nowy.' },
  { q: 'Czego potrzebujecie ode mnie przy otwieraniu mieszkania?', a: 'Dokumentu, który potwierdza, że możesz wejść do lokalu, np. dowodu z adresem albo umowy najmu. Chronimy w ten sposób także Ciebie.' },
  { q: 'Czy dojeżdżacie poza Warszawę?', a: `Tak. Obsługujemy każdą dzielnicę Warszawy oraz miejscowości wokół miasta, m.in. ${allSuburbs.slice(0, 6).join(', ')} i inne.` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Locksmith',
  name: site.name,
  telephone: site.phoneHref,
  url: site.url,
  openingHours: 'Mo-Su 00:00-23:59',
  areaServed: [{ '@type': 'City', name: 'Warszawa' }, ...allSuburbs.map((n) => ({ '@type': 'City', name: n }))],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Usługi ślusarskie', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } })) },
};
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site.url + '/'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#FFD21F" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#tresc">Przejdź do treści</a>

  <header class="bar">
    <a class="brand" href="/">Otwieramy24</a>
    <a class="bar-call" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
  </header>

  <main id="tresc">
    <section class="hero">
      <p class="now"><span class="dot" aria-hidden="true"></span><span data-now-text>Pracujemy całą dobę. Odbieramy.</span></p>
      <h1>Zamknięte drzwi, auto albo sejf? Dzwoń, przyjedziemy.</h1>
      <a class="number" href={`tel:${site.phoneHref}`} aria-label={`Zadzwoń pod numer ${site.phoneDisplay}`}>{site.phoneDisplay}</a>
      <p class="lede">Pogotowie zamkowe w Warszawie i okolicach. Każda dzielnica, przedmieścia, dzień i noc, weekendy i święta.</p>
    </section>

    <figure class="band">
      <Image src={doorPhoto} alt="Klucz w zamku uchylonych drewnianych drzwi" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" />
    </figure>

    <section class="services" aria-labelledby="uslugi">
      <div class="services-photo">
        <Image src={carPhoto} alt="Narzędzie ślusarskie w zamku drzwi samochodu" widths={[600, 900, 1200]} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div class="services-list">
        <h2 id="uslugi">Z czym przyjeżdżamy</h2>
        <dl>
          {services.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="steps" aria-labelledby="jak">
      <h2 id="jak">Od telefonu do otwartych drzwi</h2>
      <ol>
        {steps.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="area" aria-labelledby="obszar">
      <h2 id="obszar">Dojeżdżamy do każdej dzielnicy Warszawy i na przedmieścia</h2>
      <p class="area-lede">Nie ma znaczenia, czy stoisz pod blokiem na Bródnie, czy pod domem w Konstancinie.</p>
      <p class="districts" aria-label="Dzielnice Warszawy">{districts.join(', ')}.</p>
      <div class="suburbs">
        {Object.entries(suburbs).map(([dir, list]) => (
          <div>
            <h3>{dir}</h3>
            <p>{list.join(', ')}</p>
          </div>
        ))}
      </div>
      <p class="area-note">Nie widzisz swojej miejscowości? Zadzwoń. Jeśli leży w okolicy Warszawy, najpewniej dojedziemy.</p>
    </section>

    <section class="faq" aria-labelledby="pytania">
      <h2 id="pytania">Zanim zadzwonisz</h2>
      <div>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final">
      <h2>Stoisz pod drzwiami?</h2>
      <a class="number" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
    </section>
  </main>

  <footer class="foot">
    <p>Otwieramy24, pogotowie zamkowe 24h. Warszawa i okolice.</p>
    <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
  </footer>

  <a class="dock" href={`tel:${site.phoneHref}`}>Zadzwoń teraz: {site.phoneDisplay}</a>

  <script>
    const el = document.querySelector('[data-now-text]');
    if (el) {
      const d = new Date();
      const h = d.getHours();
      const time = d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
      const part = h < 5 ? 'w nocy' : h < 12 ? 'rano' : h < 18 ? 'po południu' : h < 22 ? 'wieczorem' : 'w nocy';
      el.textContent = `Jest ${time} ${part}. Odbieramy.`;
    }
  </script>
</body>
</html>

<style is:global>
  p, dd, li, summary, figcaption { text-wrap: pretty; }
  h1, h2, h3, dt { text-wrap: balance; }
  :root {
    --yellow: #FFD21F;
    --yellow-deep: #F2BE00;
    --ink: #1B1A16;
    --ink-soft: #4A4636;
    --paper: #FFFFFF;
    --signal: #D7261E;
    --font: 'Archivo Variable', 'Helvetica Neue', sans-serif;
    --pad: clamp(1rem, 5vw, 4rem);
    color-scheme: light;
    scrollbar-color: var(--ink) var(--yellow);
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font); font-size: 1.0625rem; line-height: 1.6; caret-color: var(--signal); }
  ::selection { background: var(--ink); color: var(--yellow); }
  a { color: inherit; text-underline-offset: .2em; text-decoration-thickness: .08em; }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 2px; }
  h1, h2, h3 { margin: 0; line-height: 1.05; font-variation-settings: 'wdth' 112; letter-spacing: -.02em; text-wrap: balance; }
  p { margin: 0; }
  img { display: block; max-width: 100%; height: auto; }

  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--yellow); padding: .75rem 1rem; z-index: 10; }
  .skip:focus { left: 1rem; }

  .bar { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1.1rem var(--pad); background: var(--yellow); }
  .brand { font-weight: 800; font-size: 1.35rem; text-decoration: none; font-variation-settings: 'wdth' 125; letter-spacing: -.02em; }
  .bar-call { font-weight: 700; font-variation-settings: 'wdth' 112; }

  .hero { background: var(--yellow); padding: clamp(2rem, 6vw, 5rem) var(--pad) clamp(2.5rem, 6vw, 4.5rem); }
  .now { display: inline-flex; align-items: center; gap: .6rem; font-weight: 600; margin-bottom: 2rem; }
  .dot { width: .65rem; height: .65rem; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 3px rgba(215, 38, 30, .2); }
  .hero h1 { font-size: clamp(1.6rem, 3.4vw, 2.6rem); font-weight: 700; max-width: 24ch; }
  .number {
    display: inline-block; margin: 1.25rem 0 1.5rem;
    font-size: clamp(2.6rem, 10vw, 6rem); font-weight: 800; font-variation-settings: 'wdth' 125;
    line-height: 1; letter-spacing: -.03em; text-decoration: none; white-space: nowrap;
    font-feature-settings: 'tnum';
  }
  .number:hover { text-decoration: underline; text-decoration-thickness: .05em; }
  .lede { font-size: clamp(1.05rem, 1.5vw, 1.25rem); max-width: 48ch; color: var(--ink-soft); }

  .band { margin: 0; }
  .band img { width: 100%; aspect-ratio: 21 / 8; object-fit: cover; object-position: 50% 45%; }

  section h2 { font-size: clamp(1.8rem, 3.8vw, 3rem); font-weight: 800; }

  .services { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); padding: clamp(3.5rem, 8vw, 7rem) var(--pad); align-items: start; }
  .services-photo { position: sticky; top: 1.5rem; }
  .services-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 60% 50%; border-radius: 4px; }
  .services h2 { margin-bottom: 2rem; }
  .services dl { margin: 0; }
  .services dl > div { padding: 1.25rem 0; border-top: 1px solid #E4E2DA; }
  .services dt { font-weight: 700; font-size: 1.3rem; font-variation-settings: 'wdth' 112; margin-bottom: .3rem; }
  .services dd { margin: 0; color: var(--ink-soft); max-width: 56ch; }

  .steps { padding: 0 var(--pad) clamp(3.5rem, 8vw, 7rem); }
  .steps h2 { margin-bottom: 2.5rem; max-width: 18ch; }
  .steps ol { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem; }
  .steps li { counter-increment: step; }
  .steps li::before { content: counter(step); display: block; font-size: 3.5rem; font-weight: 800; font-variation-settings: 'wdth' 125; line-height: 1; color: var(--yellow-deep); margin-bottom: .75rem; }
  .steps h3 { font-size: 1.35rem; font-weight: 700; margin-bottom: .4rem; }
  .steps p { color: var(--ink-soft); }

  .area { background: var(--yellow); padding: clamp(3.5rem, 8vw, 7rem) var(--pad); }
  .area h2 { max-width: 22ch; }
  .area-lede { margin: 1rem 0 2.5rem; font-size: 1.15rem; max-width: 52ch; }
  .districts { font-size: clamp(1.35rem, 2.6vw, 2.1rem); font-weight: 700; font-variation-settings: 'wdth' 112; line-height: 1.35; max-width: 62rem; margin-bottom: 3rem; letter-spacing: -.01em; }
  .suburbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .suburbs h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .35rem; }
  .suburbs p { color: var(--ink-soft); }
  .area-note { margin-top: 2.5rem; font-weight: 600; }

  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 3rem; padding: clamp(3.5rem, 8vw, 7rem) var(--pad); }
  .faq details { border-top: 1px solid #E4E2DA; }
  .faq details:last-child { border-bottom: 1px solid #E4E2DA; }
  .faq summary { cursor: pointer; list-style: none; padding: 1.1rem 2.5rem 1.1rem 0; position: relative; font-weight: 700; font-size: 1.15rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: ''; position: absolute; right: .4rem; top: 50%; width: .7rem; height: .7rem; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: translateY(-70%) rotate(45deg); transition: transform .25s cubic-bezier(.16, 1, .3, 1); }
  .faq details[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  .faq summary:hover { text-decoration: underline; }
  .faq details p { padding: 0 0 1.25rem; max-width: 62ch; color: var(--ink-soft); }

  .final { background: var(--ink); color: var(--yellow); padding: clamp(3rem, 7vw, 5.5rem) var(--pad); }
  .final h2 { color: #fff; }
  .final .number { margin-bottom: 0; }

  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 1.75rem var(--pad); color: var(--ink-soft); }

  .dock { position: fixed; left: .75rem; right: .75rem; bottom: .75rem; z-index: 5; display: none; text-align: center; padding: 1rem; background: var(--ink); color: var(--yellow); font-weight: 800; font-size: 1.1rem; text-decoration: none; border-radius: 10px; box-shadow: 0 8px 24px rgba(27, 26, 22, .3); }

  @media (max-width: 900px) {
    .services, .faq { grid-template-columns: 1fr; }
    .services-photo { position: static; }
    .services-photo img { aspect-ratio: 16 / 10; }
    .steps ol, .suburbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .band img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 640px) {
    .bar-call { display: none; }
    .steps ol, .suburbs { grid-template-columns: 1fr; }
    .dock { display: block; }
    .foot { padding-bottom: 6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .faq summary::after { transition: none; } }
</style>
